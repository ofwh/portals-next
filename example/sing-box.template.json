{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "google-dns",
        "server": "8.8.8.8",
        "detour": "手动选择"
      },
      {
        "type": "https",
        "tag": "cloudflare-dns",
        "server": "1.1.1.1",
        "detour": "手动选择"
      },
      {
        "type": "udp",
        "tag": "dnspod-dns",
        "server": "119.29.29.29"
      },
      {
        "type": "udp",
        "tag": "aliyun-dns",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "server": "dnspod-dns"
      },
      {
        "rule_set": ["personal-proxy", "personal-specify-proxy", "geosite-!cn"],
        "server": "google-dns"
      }
    ],
    "final": "google-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 53,
      "network": "udp"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "mtu": 9000,
      "address": "172.19.0.0/30",
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    }
  ],
  "outbounds": [],
  "route": {
    "rules": [
      {
        "inbound": ["tun-in", "mixed-in"],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      }
    ],
    "rule_set": [],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dnspod-dns"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/MetaCubeX/yacd/archive/gh-pages.zip",
      "external_ui_download_detour": "手动选择",
      "default_mode": "rule"
    }
  }
}
